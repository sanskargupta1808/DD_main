# ----- Server -----
HOST=0.0.0.0
PORT=4000
# Comma-separated list of allowed origins for CORS. Use * for local Flutter/WebView development.
CLIENT_ORIGIN=*

# ----- Extraction provider -----
# Which engine turns the transcript into structured medical data.
#   heuristic = built-in rule-based extractor (default, no API key required)
#   groq      = Groq LLM (uses GROQ_API_KEY below; OpenAI-compatible)
#   openai    = OpenAI-compatible chat completions API
#   bedrock   = AWS Bedrock (uses your AWS credentials / region)
EXTRACTION_PROVIDER=heuristic

# --- OpenAI-compatible provider (when EXTRACTION_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- AWS Bedrock provider (when EXTRACTION_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ----- STT transcript correction (ported from the Flutter Voice Rx stack) -----
# When on, /api/extract first cleans the transcript (medicine names, vitals,
# dosage phrasing) before extracting. Degrades gracefully if the Groq key or
# medicine-search service is missing.
CORRECTION_ENABLED=true
# STT locale for the Indian-OPD correction prompt: en_IN, hi_IN, gu_IN, mr_IN, …
CORRECTION_LOCALE=en_IN

# Groq (OpenAI-compatible) — used for medicine NER + transcript cleanup,
# and for structured extraction when EXTRACTION_PROVIDER=groq.
# Get a key at https://console.groq.com . Leave blank to use the alias table only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Fast model for correction (NER + cleanup):
GROQ_MODEL=llama-3.1-8b-instant
# Stronger model for medical extraction (EXTRACTION_PROVIDER=groq):
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# Whisper model for audio transcription (POST /api/transcribe).
# "whisper-large-v3-turbo" is faster but tested worse on real Indian-accented,
# code-switched audio (hallucinated repeated words, mid-transcript language
# switching) — only use it if your audio is cleaner/more monolingual than that.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# ----- Audio transcription provider -----
# Pressing Stop sends the recording here to be transcribed.
#   groq     = Groq Whisper (default; uses GROQ_* above)
#   bhashini = Govt of India Bhashini/ULCA — FREE Indic ASR (AI4Bharat IndicConformer).
#              Register at https://bhashini.gov.in and copy userID + ulcaApiKey
#              from "My Profile". Requires ffmpeg installed on the server.
#   custom   = any OpenAI-compatible /audio/transcriptions server (self-hosted
#              IndicWhisper via faster-whisper-server / speaches). Set URL + model.
TRANSCRIPTION_PROVIDER=groq

# Only used when TRANSCRIPTION_PROVIDER=custom:
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Only used when TRANSCRIPTION_PROVIDER=bhashini:
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Optional overrides (defaults to the public MeitY pipeline):
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Dual-ASR: run the regional provider (above) AND Groq Whisper(→English) in
# parallel, then merge — the conversation stays in the regional language while
# medicine names are resolved in English via FAISS. Needs a non-groq regional
# provider + GROQ_API_KEY. Doubles STT latency/cost.
DUAL_ASR=false

# (The spoken language is chosen per-recording in the UI and sent with the audio;
#  "Auto-detect" lets Whisper detect it. Bhashini needs a language — it defaults
#  to Hindi if Auto-detect is selected.)

# FAISS medicine-search service (medicine_pipeline/server.py). Start it with:
#   pip3 install -r medicine_pipeline/requirements.txt
#   python3 -m uvicorn server:app --app-dir medicine_pipeline --host 0.0.0.0 --port 8000
MEDICINE_SEARCH_URL=http://localhost:8000
MEDICINE_CONFIDENCE_THRESHOLD=85
MEDICINE_SEARCH_TIMEOUT_MS=4000

# ----- Acoustic diarization (indic_stt's pyannote engine) -----
# Used by diarization mode "acoustic" — real neural speaker-turn detection
# (pyannote/speaker-diarization-3.1) instead of the resemblyzer+KMeans engine
# or LLM-guessed labeling. Free, but the models are gated on Hugging Face:
#   1. Create a token at https://huggingface.co/settings/tokens (read access is enough)
#   2. Accept the license (one click each) on:
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/segmentation-3.0
#      https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
